      "version": 1
    },
    {
      "id": "msjvpxtdmzsrumha4u",
      "type": "text",
      "x": 500,
      "y": 3005,
      "strokeColor": "#1e1e1e",
      "text": "Also note:",
      "fontSize": 18,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
    {
      "id": "msjvpxtd7o8raiew1r3",
      "type": "text",
      "x": 500,
      "y": 3042,
      "strokeColor": "#495057",
      "text": "Vendor logs in as Supplier.\nDelivery Boy logs in as Delivery Agent.\nService Boy logs in as Field Technician.\nSociety Manager is being retired — those users\nmove to Site Supervisor.",
      "fontSize": 15,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
    {
      "id": "msjvpxtdj05gnp2wuw",
      "type": "text",
      "x": 940,
      "y": 3005,
      "strokeColor": "#c2255c",
      "text": "Still to confirm with the client:",
      "fontSize": 18,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
    {
      "id": "msjvpxtdg79tql7rdsd",
      "type": "text",
      "x": 940,
      "y": 3042,
      "strokeColor": "#495057",
      "text": "Retiring Society Manager into Site Supervisor.\nSuper Admin seeing across multiple companies.\nStorekeeper as its own separate login.\nResident portal scope — history & complaints.\nWho logs goods at the gate: security or delivery.",
      "fontSize": 15,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
    {
      "id": "msjvpxtdd6skyafikka",
      "type": "text",
      "x": 60,
      "y": 3340,
      "strokeColor": "#1e1e1e",
      "text": "Shared modules everyone draws on",
      "fontSize": 28,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
    {
      "id": "msjvpxtdrzquu0ie4p",
      "type": "text",
      "x": 60,
      "y": 3384,
      "strokeColor": "#495057",
      "text": "These sit underneath every portal above. A role is not a module — each role gets its own slice of these.",
      "fontSize": 16,
      "createdAt": "2026-08-08T04:34:11.187Z",
      "updatedAt": "2026-08-08T04:34:11.187Z",
      "version": 1
    },
